{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "JwtSettings": {
    "Secret": "C55C3E29-B58A-4B6A-914F-9E0D435E7F9A-4B6A-914F-9E0D435E7F9A",
    "Issuer": "FinVault.Service.Identity",
    "Audience": "FinVault.Clients"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default"
        }
      },

      "currentaccount-route": {
        "ClusterId": "currentaccount-cluster",
        "Match": { "Path": "/api/v1/accounts/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/movements/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      },

      "document-ingestion-route": {
        "ClusterId": "document-ingestion-cluster",
        "Match": { "Path": "/api/v1/document/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/document/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      },

      "investments-route": {
        "ClusterId": "investments-cluster",
        "Match": { "Path": "/api/v1/investments/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/investments/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      },

      "pension-plans-route": {
        "ClusterId": "pension-plans-cluster",
        "Match": { "Path": "/api/v1/pension-plans/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/pension-plans/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      },

      "PayrollAnalysis-route": {
        "ClusterId": "payroll-analysis-cluster",
        "Match": { "Path": "/api/v1/payroll-analysis/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/payroll-analysis/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      },

      "savings-bonds-route": {
        "ClusterId": "savings-bonds-cluster",
        "Match": { "Path": "/api/v1/savings-bonds/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/savings-bonds/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      },

      "savings-rate-route": {
        "ClusterId": "savings-bonds-cluster",
        "Match": { "Path": "/api/v1/rate-history/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/rate-history/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      },

      "market-prices-route": {
        "ClusterId": "market-prices-cluster",
        "Match": { "Path": "/api/v1/market-prices/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/marketprices/{**catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy",
        "Metadata": {
          "ResiliencePolicy": "default",
          "AuthorizationPolicy": "Default"
        }
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "d1": { "Address": "http://identity-service:8080/" }
        },
        "Metadata": { "SwaggerEndpoint": "/swagger/v1/swagger.json" }
      },

      "currentaccount-cluster": {
        "Destinations": {
          "d1": { "Address": "http://currentaccount-service:8080/" }
        },
        "Metadata": { "SwaggerEndpoint": "/swagger/v1/swagger.json" }
      },

      "document-ingestion-cluster": {
        "Destinations": {
          "d1": { "Address": "http://document-ingestion:8080/" }
        },
        "Metadata": { "SwaggerEndpoint": "/swagger/v1/swagger.json" }
      },

      "investments-cluster": {
        "Destinations": {
          "d1": { "Address": "http://investments-service:8080/" }
        },
        "Metadata": { "SwaggerEndpoint": "/swagger/v1/swagger.json" }
      },

      "pension-plans-cluster": {
        "Destinations": {
          "d1": { "Address": "http://pensionplans-service:8080/" }
        },
        "Metadata": { "SwaggerEndpoint": "/swagger/v1/swagger.json" }
      },

      "payroll-analysis-cluster": {
        "Destinations": {
          "d1": { "Address": "http://payrollanalysis-service:8080/" }
        },
        "Metadata": { "SwaggerEndpoint": "/swagger/v1/swagger.json" }
      },

      "savings-bonds-cluster": {
        "Destinations": {
          "d1": { "Address": "http://savings-bonds-service:8080/" }
        },
        "Metadata": { "SwaggerEndpoint": "/swagger/v1/swagger.json" }
      },

      "market-prices-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://market-prices-service:8080",
            "Health": "http://market-prices-service:8080/health"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures"
          }
        }
      }
    }
  }
}
