{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "currentaccount-route": {
        "ClusterId": "currentaccount-cluster",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/movements/{catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy"
      },
      "document-ingestion-route": {
        "ClusterId": "document-ingestion-cluster",
        "Match": {
          "Path": "/api/Document/{**catch-all}"
        },
        "CorsPolicy": "AngularFrontendPolicy"
      },
      "investments-route": {
        "ClusterId": "investments-cluster",
        "Match": {
          "Path": "/api/investments/{**catch-all}"
        },
        "CorsPolicy": "AngularFrontendPolicy"
      },
      "investments-v1-route": {
        "ClusterId": "investments-cluster",
        "Match": {
          "Path": "/api/v1/investments/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/investments/{catch-all}" }
        ],
        "CorsPolicy": "AngularFrontendPolicy"
      }
    },
    "Clusters": {
      "currentaccount-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://currentaccount-service:8080/"
          }
        }
      },
      "document-ingestion-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://document-ingestion:8080/"
          }
        }
      },
      "investments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://investments-service:8080/"
          }
        }
      }
    }
  }
}